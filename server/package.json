{
  "name": "sound-chain-backend",
  "version": "1.0.0",
  "description": "Express + MongoDB backend for the Sound Chain Sequence game",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' nodemon src/server.js",
    "start": "NODE_OPTIONS='--no-deprecation' node src/server.js",
    "check": "node --check src/server.js",
    "smoke": "node scripts/smoke-health.js",
    "ci": "npm run check && npm test && npm run smoke",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
