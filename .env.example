# =========================================
# KiChain root environment configuration
# =========================================
# Copy this file to .env in the repository root:
#   cp .env.example .env
#
# The client and server are both configured to read from this root .env file.
# Do not create separate client/.env or server/.env files.

# =========================================
# Client / Frontend Configuration
# =========================================

FRONTEND_PORT=5173

# Base URL for backend REST API.
VITE_API_URL=http://localhost:3000/api

# Base URL for Socket.IO server.
VITE_SOCKET_URL=http://localhost:3000

# App metadata.
VITE_APP_NAME=KiChain
VITE_APP_ENV=development

# Optional: set to true only for the shared remote dev-server deployment.
# This disables Vite's HMR websocket behind CloudFront/Nginx while keeping
# normal local hot reload enabled by default.
# VITE_DISABLE_HMR=true

# =========================================
# Server / Backend Configuration
# =========================================

# Express server port.
PORT=3000

# Allowed frontend origin for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Local npm development default:
# - Use this when the backend runs on your host machine.
# - If MongoDB is running in Docker with -p 27017:27017, localhost works from the host.
MONGODB_URI=mongodb://localhost:27017/kichain-db

# Docker app-container development:
# - When the backend itself runs inside Docker on the kichain-net network,
#   override MONGODB_URI at docker run time:
#   -e MONGODB_URI=mongodb://kichain-db:27017/kichain-db

# Used to sign and expire login / guest JWTs.
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1d
