{
  "name": "group-project-chiwifruit",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack client/server workspace for group-project-chiwifruit",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -c \"cyan.bold,magenta.bold\" \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "install:all": "npm install",
    "install:e2e": "playwright install chromium",
    "test:e2e": "npm run install:e2e && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "ci": "npm run ci --workspace=client && npm run ci --workspace=server"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^9.2.1"
  }
}
