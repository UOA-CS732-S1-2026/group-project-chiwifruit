{
  "name": "group-project-chiwifruit",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack client/server workspace for group-project-chiwifruit",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -c \"cyan.bold,magenta.bold\" \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
